        public static async Task serverPresence()
        {
            while (true)
            {
                using (var webclient = new WebClient())
                {
                    try
                    {
                        webclient.DownloadString(BaseUrl + "/server/setPing?accesskey=" + ScriptAccessKey);
                        await Task.Delay(30000);
                    }
                    catch(Exception e)
                    {
                        Console.WriteLine(">> Failed to set server ping: "+e.Message);
                        Console.WriteLine(">> Trying again in 5 seconds");
                        await Task.Delay(5000);
                    }
                }
            }
        }

        public static void checkQueue()
        {
            while (true)
            {
                Console.ForegroundColor = ConsoleColor.Cyan;
                Console.WriteLine(">> checking render queue...");
                var queue = new TimedWebClient {Timeout = 15000}.DownloadString(BaseUrl + "/server/renderqueue?accesskey=" + ScriptAccessKey);

                if (queue != "fart")
                {
                    dynamic queuedata = JsonConvert.DeserializeObject(queue);
                    int jobid = queuedata.jobId;
                    string type = queuedata.renderType;
                    string data = queuedata.renderData;
                    Console.ForegroundColor = ConsoleColor.Green;
                    Console.WriteLine(">> render job detected!");
                    Console.ForegroundColor = ConsoleColor.Yellow;
                    Console.WriteLine(">> job id: "+jobid);
                    Console.WriteLine(">> render type: "+type);
                    Console.WriteLine(">> render data: "+data);
                    Console.WriteLine(">>");

                    switch (type)
                    {
                        case "Player":
                            StartRender(data, jobid, RenderType.Player);
                            break;

                        case "Model":
                            StartRender(data, jobid, RenderType.Model);
                            break;

                        case "Place":
                            StartRender(data, jobid, RenderType.Place);
                            break;

                        case "Head":
                            StartRender(data, jobid, RenderType.Head);
                            break;

                        case "Shirt":
                            StartRender(data, jobid, RenderType.Head);
                            break;

                        case "Pants":
                            StartRender(data, jobid, RenderType.Head);
                            break;

                        default:
                            ReturnError("invalid render type [must be \"player\", \"model\", or \"place\"]");
                            break;
                    }

                    Console.WriteLine(">> ");
                    Console.ForegroundColor = ConsoleColor.Green;
                    Console.WriteLine(">>> render job complete! i think [completed at " + GetTime() + "] <<<");
                }
                else
                {
                    Console.ForegroundColor = ConsoleColor.Red;
                    Console.WriteLine(">> queue is empty");
                    Console.ForegroundColor = ConsoleColor.Cyan;
                    Console.WriteLine(">> now hibernating for 10 seconds");
                    Console.WriteLine(">>");
                    Thread.Sleep(10000);
                }
            }
        }

