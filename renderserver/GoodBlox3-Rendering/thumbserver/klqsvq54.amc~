                    var bmp = CaptureScreen(res_x, res_y, offset_x, offset_y, true, false, false);
                    SaveScreenshot("jobId" + jobId + "-946x946.png", bmp);
                    SaveScreenshot("jobId" + jobId + "-420x420.png", ResizeBitmap(bmp, 420, 420));
                    SaveScreenshot("jobId" + jobId + "-352x352.png", ResizeBitmap(bmp, 352, 352));
                }
                else
                {
                    var bmp = CaptureScreen(res_x, res_y, offset_x, offset_y, true);
                    SaveScreenshot("jobId" + jobId + "-946x946.png", bmp);
                    SaveScreenshot("jobId" + jobId + "-420x420.png", ResizeBitmap(bmp, 420, 420));
                    SaveScreenshot("jobId" + jobId + "-352x352.png", ResizeBitmap(bmp, 352, 352));
