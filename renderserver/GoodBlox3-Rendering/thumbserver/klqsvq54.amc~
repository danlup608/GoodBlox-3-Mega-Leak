        public static void ExecuteScript(string script, Workspace workspace)
        {
            XmlDocument config = new XmlDocument();
            config.Load(@"renderserverConfig.xml");
            try { workspace.ExecUrlScript($"{BaseUrl_http}/ExecScript?script={WebUtility.UrlEncode(script)}&signature={config.SelectNodes("//scriptSignature")[0].InnerXml}&accesskey={ScriptAccessKey}"); }
