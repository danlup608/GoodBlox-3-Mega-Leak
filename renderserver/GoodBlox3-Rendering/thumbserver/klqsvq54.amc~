        private static void StartRender(string assetUrl, int jobId, RenderType renderType)
        {
            XmlDocument config = new XmlDocument();
            config.Load(@"renderserverConfig.xml");
            string scriptSignature = config.SelectNodes("//scriptSignature")[0].InnerXml;

            Initialize(out Workspace workspace);

            Console.ForegroundColor = ConsoleColor.Yellow;
            Console.WriteLine(">> starting new render job [type: {0}] [{1}] <<", renderType, GetTime());
            Console.WriteLine(">> ");

            Console.ForegroundColor = ConsoleColor.Cyan;
            Console.WriteLine(">> executing render script");
            Console.WriteLine(">> loading asset at [" + GetTime() + "]");

            if (renderType != RenderType.Player && renderType != RenderType.Head && renderType != RenderType.Shirt && renderType != RenderType.Pants)
            {
                Int32 BeforeLoad = GetTimestamp();
                //this is a really hacky way to signal the server app that the asset has loaded but its the best i can do lol
                try
                {
                    workspace.ExecUrlScript($"{BaseUrl_http}/doRender?assetId={WebUtility.UrlEncode(assetUrl)}&renderType={renderType}&accessKey={ScriptAccessKey}&signature={scriptSignature}&preventCaching={new Random().Next()}");
                }
                catch (Exception e)
                {
                    if (!e.Message.Contains("hi.")) { ReturnError(e.Message); }
                    Int32 AfterLoad = GetTimestamp();
                    int timeToLoad = AfterLoad - BeforeLoad;

                    Console.WriteLine(">> asset loaded at [" + GetTime() + "]"); ;
                    Console.WriteLine(">> time for asset to load: " + timeToLoad + " seconds");

                    if (timeToLoad == 0) { Thread.Sleep(750); }
                    else if (timeToLoad <= 2) { Thread.Sleep(1250); }
                    else if (timeToLoad <= 4) { Thread.Sleep(2750); }
                    else if (timeToLoad <= 5) { Thread.Sleep(3750); }
                    else if (timeToLoad <= 6) { Thread.Sleep(4750); }
                    else { Thread.Sleep(5500); }
                    if (renderType == RenderType.Model)
                    {
                        ExecuteScript("", workspace);
                        Thread.Sleep(100);
                        ThumbnailView();
                    }
                    else if (renderType == RenderType.Head)
                    {
                        ExecuteScript("", workspace);
                        Thread.Sleep(100);
                        ThumbnailView();
                    }
                    else if (renderType == RenderType.Shirt)
                    {
                        ExecuteScript("", workspace);
                        Thread.Sleep(100);
                        ThumbnailView();
                    }
                }
            }
            else
            {
                try
                {
                    workspace.ExecUrlScript($"{BaseUrl_http}/doRender?assetId={WebUtility.UrlEncode(assetUrl)}&renderType={renderType}&accessKey={ScriptAccessKey}&signature={scriptSignature}&preventCaching={new Random().Next()}");
                }
                catch (Exception e) { ReturnError(e.Message); }
                Thread.Sleep(4000);
                ThumbnailView();
            }

            var webclient = new WebClient();

            Console.WriteLine(">> ");
            if (renderType == RenderType.Place)
            {
                int offset_x = Int32.Parse(config.SelectNodes("//place_screenshot/offset_x")[0].InnerXml);
                int offset_y = Int32.Parse(config.SelectNodes("//place_screenshot/offset_y")[0].InnerXml);
                int res_x = Int32.Parse(config.SelectNodes("//place_screenshot/res_x")[0].InnerXml);
                int res_y = Int32.Parse(config.SelectNodes("//place_screenshot/res_y")[0].InnerXml);
                var bmp = CaptureScreen(res_x, res_y, offset_x, offset_y, false);
                SaveScreenshot("jobId" + jobId + "-1680x946.png", bmp);
                SaveScreenshot("jobId" + jobId + "-768x432.png", ResizeBitmap(bmp, 768, 432));
                uploadImage("renders-online\\jobId" + jobId + "-768x432.png");
                string response = webclient.DownloadString($"{BaseUrl}/server/updaterender?accesskey={ScriptAccessKey}&type=1&response={WebUtility.UrlEncode("renders/jobId"+jobId+ "-768x432.png")}");
                if (response != "success") { Console.WriteLine(">> Could not update response; Error message: " + response); }
            }
            else
            {
                int offset_x = Int32.Parse(config.SelectNodes("//model_screenshot/offset_x")[0].InnerXml);
                int offset_y = Int32.Parse(config.SelectNodes("//model_screenshot/offset_y")[0].InnerXml);
                int res_x = Int32.Parse(config.SelectNodes("//model_screenshot/res_x")[0].InnerXml);
                int res_y = Int32.Parse(config.SelectNodes("//model_screenshot/res_y")[0].InnerXml);
                if (renderType == RenderType.Model)
