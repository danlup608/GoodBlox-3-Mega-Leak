        public static Bitmap ResizeBitmap(Bitmap bmp, int width, int height)
        {
            Console.WriteLine(">> resizing image to x: "+width+" y:"+height);
            var resize = new Bitmap(width, height);
            using (var graphicsobj = Graphics.FromImage(resize)){ graphicsobj.DrawImage(bmp, 0, 0, width, height); }
            return resize;
        }

        public static Bitmap CaptureScreen(int sizex, int sizey, int offsetx, int offsety, bool ChromaKey = true, bool AlphaMask = false, bool makeGreenTransparent = true)
        {
            Console.WriteLine($">> capturing initial screenshot [x: {sizex}, y: {sizey}, offset: {offsetx}, {offsety}]");
            var bmp = new Bitmap(sizex, sizey);
            var graphicsobject = Graphics.FromImage(bmp);
            graphicsobject.CopyFromScreen(offsetx, offsety, 0, 0, bmp.Size);

            if (AlphaMask)
            {
                Console.WriteLine(">> experimental alpha mask enabled");
                var greenmask = new Bitmap(bmp);
                Console.WriteLine(">> filtering red and green...");
                for (int y = 0; y < greenmask.Height; y++)
                {
                    for (int x = 0; x < greenmask.Width; x++)
                    {
                        Color pixel = greenmask.GetPixel(x, y);
                        greenmask.SetPixel(x, y, Color.FromArgb(pixel.A, pixel.R, 0, pixel.B));
                    }
                }
                greenmask.Save("greenmask.png", ImageFormat.Png);
                Console.WriteLine(">> saved green mask image");
            }

            if (ChromaKey)
            {
                Console.WriteLine(">> chroma keying render");
                if (makeGreenTransparent)
                {
                    bmp.MakeTransparent(Color.FromArgb(0, 255, 0));
                    bmp.MakeTransparent(Color.FromArgb(0, 255, 1));
                    bmp.MakeTransparent(Color.FromArgb(75, 254, 0));
                    bmp.MakeTransparent(Color.FromArgb(75, 255, 0));
                    bmp.MakeTransparent(Color.FromArgb(82, 255, 0));
                    bmp.MakeTransparent(Color.FromArgb(79, 254, 0));
                    bmp.MakeTransparent(Color.FromArgb(79, 255, 0));
                }
                else
                {
                    bmp.MakeTransparent(Color.FromArgb(255, 255, 255));
                }
            }
            return bmp;
        }

